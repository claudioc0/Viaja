# Server
NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:3000,http://localhost:3105

# Database (PostgreSQL via Docker Compose)
DATABASE_URL="postgresql://viaja:viaja_dev_password@localhost:5432/viaja_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="replace-with-strong-access-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Observability (Phase 7)
SENTRY_DSN=""
