{
  "name": "viaja",
  "version": "0.1.0",
  "private": true,
  "description": "VIAJA — Plataforma Inteligente de Mobilidade Rodoviária (Monorepo)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @viaja/api run dev",
    "dev:mobile": "pnpm --filter @viaja/mobile run start",
    "dev:web": "pnpm --filter @viaja/web run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:migrate": "pnpm --filter @viaja/api run db:migrate",
    "db:seed": "pnpm --filter @viaja/api run db:seed",
    "db:studio": "pnpm --filter @viaja/api run db:studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
